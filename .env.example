# Banco Postgres (Neon: copie a "connection string" do painel)
DATABASE_URL=postgres://usuario:senha@host/banco?sslmode=require
# Uma frase longa e aleatória. Não compartilhe.
PAYLOAD_SECRET=troque-por-uma-frase-longa-e-aleatoria
# Endereço do site (em produção, o domínio da loja)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Só em produção: token do Vercel Blob para guardar as fotos
BLOB_READ_WRITE_TOKEN=
